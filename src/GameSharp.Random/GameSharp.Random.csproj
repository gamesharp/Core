<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>willbldn</Authors>
    <Description>
      High-performance, zero-allocation random generation and procedural tools for .NET 10. Features deterministic seeds, 
      vector and quaternion sampling, Gaussian and curved distributions, in-place shuffling, and thread-safe operations.
    </Description>
    <Copyright>Copyright © 2026 William Brocklesby</Copyright>
    <PackageTags>random prng procedural-generation gamedev vectors quaternion gaussian distribution noise shuffle deterministic seed math gamesharp dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/gamesharp/Core/tree/master/src/GameSharp.Random</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/gamesharp/Core.git</RepositoryUrl>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
